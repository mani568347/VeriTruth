# VeriTruth environment configuration — copy to .env and fill in real values.
# NEVER commit the real .env file.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Groq (AI explanation + Ask VeriTruth assistant)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth (configured in the Django admin under Social Applications,
# when using database-backed allauth configuration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset email (Gmail app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
